{
  "inputs": [
    {
      "id": "agentsMcpUrl",
      "type": "promptString",
      "description": "Demo agents MCP endpoint URL, for example https://YOUR-AGENTS-MCP-FQDN/mcp"
    },
    {
      "id": "azureDevOpsOrg",
      "type": "promptString",
      "description": "Azure DevOps organization name"
    }
  ],
  "servers": {
    "demo-agents-mcp": {
      "type": "http",
      "url": "${input:agentsMcpUrl}"
    },
    "microsoft-enterprise-mcp": {
      "type": "http",
      "url": "https://mcp.svc.cloud.microsoft/enterprise"
    },
    "azure-devops-mquadri": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@azure-devops/mcp", "${input:azureDevOpsOrg}"]
    }
  }
}
